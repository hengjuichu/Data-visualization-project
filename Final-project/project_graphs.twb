        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;larceny&quot; THEN [larceny]&#10;WHEN &quot;burglary&quot; THEN [burglary]&#10;WHEN &quot;robbery&quot; THEN [robbery]&#10;WHEN &quot;homicide&quot; THEN [homicide]&#10;WHEN &quot;aggravated_assault&quot; THEN [aggravated_assault]&#10;WHEN &quot;motor_vehicle_theft&quot; THEN [motor_vehicle_theft]&#10;END' />
      </column>
      <column caption='Selected Crime Filter' datatype='boolean' name='[Calculation_4181431714299907]' role='dimension' type='nominal'>
